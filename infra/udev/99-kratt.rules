# Stable symlinks for the ESP32-S3 USB-CDC devices.
# Each board flashes a unique iSerial; match on that.

SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", \
    ATTRS{serial}=="kratt-sensor-rack-0", SYMLINK+="kratt-sensor-mcu-0", \
    GROUP="kratt", MODE="0660"

SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", \
    ATTRS{serial}=="kratt-safety", SYMLINK+="kratt-safety-mcu", \
    GROUP="kratt", MODE="0660"

SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", \
    ATTRS{serial}=="kratt-composter", SYMLINK+="kratt-composter-mcu", \
    GROUP="kratt", MODE="0660"
