[Unit]
Description=KrattOS local UI (FastAPI + SvelteKit, LAN only)
PartOf=kratt.target
After=kratt-bus.service

[Service]
Type=simple
User=kratt
ExecStart=/usr/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8080
WorkingDirectory=/opt/kratt/ui/backend
Restart=always
RestartSec=2

[Install]
WantedBy=kratt.target kratt-lite.target kratt-greenhouse.target