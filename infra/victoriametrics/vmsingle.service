[Unit]
Description=VictoriaMetrics single-node (GroveOS sensor telemetry)
Documentation=https://docs.victoriametrics.com/
PartOf=grove.target
Before=grove-sensor-ingest.service grove-timeseries.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grove
Group=grove
ExecStart=/usr/local/bin/victoria-metrics-prod \
  -storageDataPath=/var/lib/grove/tsdb \
  -retentionPeriod=14d \
  -downsampling.period=1m:0s \
  -httpListenAddr=127.0.0.1:8428 \
  -memory.allowedBytes=536870912 \
  -search.maxUniqueTimeseries=50000 \
  -search.maxSamplesPerSeries=30000000
Restart=always
RestartSec=2
LimitNOFILE=65536
MemoryMax=600M
OOMPolicy=continue

# Hardening
ProtectSystem=strict
ReadWritePaths=/var/lib/grove/tsdb
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=grove.target
