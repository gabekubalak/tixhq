[Unit]
Description=VictoriaMetrics single-node (KrattOS sensor telemetry)
Documentation=https://docs.victoriametrics.com/
PartOf=kratt.target
Before=kratt-sensor-ingest.service kratt-timeseries.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kratt
Group=kratt
ExecStart=/usr/local/bin/victoria-metrics-prod \
  -storageDataPath=/var/lib/kratt/tsdb \
  -retentionPeriod=14d \
  -downsampling.period=1m:0s \
  -httpListenAddr=127.0.0.1:8428 \
  -memory.allowedBytes=536870912 \
  -search.maxUniqueTimeseries=50000 \
  -search.maxSamplesPerSeries=30000000
Restart=always
RestartSec=2
LimitNOFILE=65536
MemoryMax=600M
OOMPolicy=continue

# Hardening
ProtectSystem=strict
ReadWritePaths=/var/lib/kratt/tsdb
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=kratt.target
