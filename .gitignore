# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Rust
target/
**/*.rs.bk
# Cargo.lock is committed: every workspace member is a binary, not a library.

# ESP-IDF (scoped to firmware so an unanchored "build/" does not also
# swallow web routes like site/src/routes/build/)
firmware/**/build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock

# Node / SvelteKit
node_modules/
.svelte-kit/
ui/frontend/build/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Local state (never commit)
data/
state/
logs/
*.db
*.db-journal

# Models are tracked outside git (LFS or signed bundles)
models/*.onnx
models/*.bin
models/*.txt

# Secrets
*.key
*.pem
minisign.sec

# Local Claude Code settings (personal, not project config)
.claude/settings.local.json
